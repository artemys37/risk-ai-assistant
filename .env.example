# ============================================================
# SPRINT — Configuration LLM (NE JAMAIS COMMITER le fichier .env)
# Toutes les clés API passent par les variables d'environnement.
# ============================================================

# Fournisseur LLM : openai | anthropic | ollama | mistral | ...
LLM_PROVIDER=

# Modèle utilisé (ex. : gpt-4o-mini, claude-sonnet-4-20250514, llama3.1)
LLM_MODEL=

# Clé API du fournisseur (laisser vide pour Ollama local)
LLM_API_KEY=

# Base URL optionnelle (Ollama, proxies compatibles OpenAI, etc.)
LLM_BASE_URL=

# Température LLM (0.0 = déterministe, 1.0 = créatif)
LLM_TEMPERATURE=0.0

# Timeout d'appel LLM (s)
LLM_TIMEOUT=600

# Nombre max de tokens générés par appel (défaut 1024)
LLM_MAX_TOKENS=1024

# Taille de contexte LLM (défaut 4096)
LLM_CONTEXT_LENGTH=4096

# ============================================================
# Base de données (SQLite pour le prototype, migrable PostgreSQL)
# ============================================================
DATABASE_URL=sqlite:///./data/risk_ai.db

# ============================================================
# Sécurité des imports documentaires
# ============================================================
# Taille maximale d'un fichier importé (MB)
MAX_FILE_SIZE_MB=10
# Extensions autorisées
ALLOWED_EXTENSIONS=pdf,txt,docx,md,json,csv

# ============================================================
# Application
# ============================================================
APP_HOST=127.0.0.1
APP_PORT=8000
# Nom de l'analyste utilisé dans le journal d'audit (démo)
ANALYST_NAME=analyste-demo
